#include "diplomat_nanobind_common.hpp"
#include <../src/nb_internals.h>  // Required for shimming

// Forward declarations for binding add functions
{% for (ns, lines) in fwd_decls.iter() -%}

namespace {{module_name}} {%- if !ns.is_empty() -%} ::{{ns}} {%- endif -%} {
  {% for line in lines %}
    {{~ line }}
  {%- endfor %}
}
{%- endfor %}

// Nanobind does not usually support custom deleters, so we're shimming some of the machinery to add that ability.
// On module init, the dummy type will have the normal nanobind inst_dealloc function in the tp_dealloc slot, so we
// pull it out, store it here, and then call it in the tp_dealloc function we are shimming in to all our types.
// Our custom tp_dealloc function will call the tp_free function instead of `delete`, allowing us effectively to override
// the delete operator.
// See https://nanobind.readthedocs.io/en/latest/lowlevel.html#customizing-type-creation and
// https://github.com/wjakob/nanobind/discussions/932
void (*nb_tp_dealloc)(void *) = nullptr;

void diplomat_tp_dealloc(PyObject *self)
{
    using namespace nb::detail;
    PyTypeObject *tp = Py_TYPE(self);
    const type_data *t = nb_type_data(tp);

    nb_inst *inst = (nb_inst *)self;
    void *p = inst_ptr(inst);
    if (inst->destruct)
    {
        inst->destruct = false;
        check(t->flags & (uint32_t)type_flags::is_destructible,
              "nanobind::detail::inst_dealloc(\"%s\"): attempted to call "
              "the destructor of a non-destructible type!",
              t->name);
        if (t->flags & (uint32_t)type_flags::has_destruct)
            t->destruct(p);
    }
    if (inst->cpp_delete)
    {
        inst->cpp_delete = false;
        auto tp_free = (freefunc)(PyType_GetSlot(tp, Py_tp_free));
        (*tp_free)(p);
    }
    (*nb_tp_dealloc)(self);
}

struct _Dummy {};

// FIXME: This needs to be freed when the module is freed.
PyObject* last_ffi_error;

void swap_ffi_error(PyObject* ffi_error) {
    Py_XDECREF(last_ffi_error);
    Py_INCREF(ffi_error);
    last_ffi_error = ffi_error;
}

void set_ffi_error(PyObject* exception, const char* msg) {
    Py_XDECREF(last_ffi_error);

    PyObject* str = PyUnicode_FromString(msg);
    PyObject* tuple = PyTuple_Pack(1, str);

    last_ffi_error = PyObject_Call(exception, tuple, NULL);
    Py_DECREF(str);
    Py_DECREF(tuple);

    // Create a traceback from the given frame.
    // This is a little wonky, could be less so if the methods from
    // https://peps.python.org/pep-0523/ are stabilized
    PyFrameObject* current_frame = PyEval_GetFrame();

    // Increment the reference, since setting the exception takes ownership:
    Py_INCREF(last_ffi_error);
    // Python 3.12.0 final
    #if PY_VERSION_HEX >= 0x030c00f0
    // We can just set the raised exception:
    PyErr_SetRaisedException(last_ffi_error);
    #else
    PyErr_Restore(exception, last_ffi_error, NULL);
    #endif
    PyTraceBack_Here(current_frame);
    PyErr_Clear();
}

void diplomat_cleanup() {
    Py_XDECREF(last_ffi_error);
}

NB_MODULE({{module_name}}, mod)
{
    using namespace {{module_name}};

    {
        nb::class_<_Dummy> dummy(mod, "__dummy__");
        nb_tp_dealloc = (void (*)(void *))nb::type_get_slot(dummy, Py_tp_dealloc);
    }

    mod.def("get_last_ffi_error", []() {
        if (last_ffi_error == NULL || Py_REFCNT(last_ffi_error) == 0) {
            PyErr_SetString(PyExc_RuntimeError, "FFI Error not found, either no FFI error was set or the FFI error has been freed.");
            throw nb::python_error();
        }

        // We still want to hold on to this error, so we incref on return:
        Py_INCREF(last_ffi_error);
        return nb::handle(last_ffi_error);
    });

    if (Py_AtExit(diplomat_cleanup) != 0) {
        fprintf(stderr, "Could not clean up Diplomat module.");
    }

    nb::class_<std::monostate>(mod, "monostate")
        .def("__repr__", [](const std::monostate &)
             { return ""; })
        .def("__str__", [](const std::monostate &)
             { return ""; });
             

    {%- let mod_str = ["mod".to_string()] -%}
    // Module declarations
    {% for module_path in sub_modules %}
        {%- let module_name = [module_path.as_slice(), mod_str.as_slice()].concat().join("_") -%}
        {%- let parent_name = [module_path[..module_path.len()-1], mod_str.as_slice()].concat().join("_") -%}
        nb::module_ {{module_name}} = {{parent_name}}.def_submodule("{{module_path.last().unwrap()}}");
    {% endfor -%}

    // Add bindings
    {%- for (namespaces, fns) in module_fns -%}
        {%- let module_name = [namespaces.as_slice(), mod_str.as_slice()].concat().join("_") -%}
        {% for func in fns %}
    {{ func -}}({{module_name}});
        {%- endfor %}
    {% endfor %}
    
}
