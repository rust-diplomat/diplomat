{%- for exception_name in docs.exception_names %}
    /// <exception cref="{{ exception_name }}"></exception>
{%- endfor %}
{%- if let Some(opaque_name) = docs.returns_opaque %}
    /// <returns>
    /// A <c>{{ opaque_name }}</c> allocated on Rust side.
    /// </returns>
{%- endif %}
{%- if let Some(lifetime) = docs.lifetime %}
    /// <remarks>
    /// Lifetime: the returned native-backed value may borrow from the receiver or one or more inputs.
    /// Source handles stay reachable while the returned value exists.
{%- if lifetime.pinned_inputs %}
    /// <br/>
    /// Warning: this call pins the buffer passed via <c>ReadOnlyMemory</c> for as long as the returned value, and anything borrowing from it, is alive.
    /// The pin is released by <c>Dispose()</c> when the type has one, otherwise only when the garbage collector finalizes the value.
    /// Do not mutate the buffer while the returned value is in use, and keep the returned value short-lived if the buffer is large.
{%- endif %}
    /// </remarks>
{%- endif %}
